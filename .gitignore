# ==============================================================================
# AI Shopkeeper Assistant - Git Ignore Rules
# Excludes sensitive secrets, virtual environments, caches, and local dumps.
# ==============================================================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Logs and runtime artifacts
*.log
*.sqlite3
*.dump
*.sql.bak
shop_settings.json

# IDE and OS files
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
