# ==============================================================================
# AI Shopkeeper - Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit your real .env file or API keys to GitHub or public repositories.
# ==============================================================================

# Google Gemini / Gemma API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Configuration
# Ensure MySQL is running (e.g., via XAMPP Control Panel) and shopkeeper_ai is created
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=shopkeeper_ai

# Optional Flask Server Port (defaults to 5000 if not specified)
PORT=5000
