# ==============================================================================
# AI Shopkeeper Assistant - Environment Configuration Template
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit your real .env file or API keys to GitHub or public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini / Gemma API Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Configured AI Models (Primary & Fallback)
GEMMA_MODEL=gemma-4-31b-it
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it

# ------------------------------------------------------------------------------
# 2. MySQL Database Configuration
# For local development: Point to your local MySQL (e.g. XAMPP on localhost:3306)
# For Render deployment: Provide your hosted cloud MySQL connection details
# (e.g. TiDB Cloud Serverless, Railway, Aiven, or Clever Cloud)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shopkeeper_ai

# (Alternative) Single Connection URI:
# If your cloud provider supplies a full connection URL, you can set DATABASE_URL
# instead of the individual DB_* variables above:
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# Cloud Database SSL Configuration (Optional)
# Most cloud MySQL hosts (TiDB, Aiven) require SSL:
# DB_SSL_DISABLED=false
# DB_SSL_CA=/path/to/ca.pem

# ------------------------------------------------------------------------------
# 3. Web Application & Server Configuration
# ------------------------------------------------------------------------------
SECRET_KEY=generate_a_secure_random_key_for_production
PORT=5000
HOST=127.0.0.1
